// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String            @id @default(cuid())
  name        String
  email       String            @unique
  password    String
  role               Role              @default(EMPLOYEE)
  preferenceEnabled  Boolean           @default(true)
  extraSubmitEnabled Boolean           @default(false)
  createdAt          DateTime          @default(now())
  preferences  ShiftPreference[]
  assignments  ShiftAssignment[]
  attendances  AttendanceRecord[]
  submissions  PreferenceSubmission[]
}

enum Role {
  EMPLOYEE
  ADMIN
}

model ShiftPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  shift     Shift
  createdAt DateTime @default(now())

  @@unique([userId, date, shift])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  shift      Shift
  assignedBy String
  createdAt  DateTime @default(now())

  @@unique([userId, date, shift])
}

enum Shift {
  A
  B
  C
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date @unique
  name      String
  createdAt DateTime @default(now())
}

enum AttendanceType {
  A
  B
  C
  SL
  OT
  ABS
  RE
  OB
  SPECIAL
  QUIZ
  SC
}

model AttendanceRecord {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  type      AttendanceType
  note            String?
  durationMinutes Int?
  createdAt       DateTime       @default(now())

  @@unique([userId, date, type])
}

model AttendanceLog {
  id        String         @id @default(cuid())
  userId    String
  userName  String
  date      DateTime       @db.Date
  type      AttendanceType
  action    String
  adminId   String
  adminName String
  createdAt DateTime       @default(now())
}

model PreferenceSubmission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  submittedAt DateTime  @default(now())
  confirmedAt DateTime?

  @@unique([userId, year, month])
}

model SchedulePublish {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  publishedAt DateTime @default(now())
  publishedBy String

  @@unique([year, month])
}
